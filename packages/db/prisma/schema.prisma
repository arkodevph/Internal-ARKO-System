generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== BASE MODELS =====

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  password     String?
  image        String?
  avatar       Json?      @default("{}")
  phone        String?
  title        String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?  @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  accounts              Account[]
  sessions              Session[]
  workspaceMembers      WorkspaceMember[]
  transactions          Transaction[]
  accountCategories     AccountCategory[]
  splitShares           SplitShare[]
  tasks                 Task[]
  comments              Comment[]
  workflows             Workflow[]
  conversationLinks     ConversationParticipant[]
  sentMessages          Message[]
  reminders             Reminder[]
  notes                 Note[]
  events                Event[]
  sprints               Sprint[]
  ideas                 Idea[]
  journalEntries        JournalEntry[]
  notifications         Notification[]
  resources             Resource[]
  resourceCategories    ResourceCategory[]
  fileAttachments       FileAttachment[]
  metrics               BusinessMetric[]
  recurring             RecurringTransaction[]
  budgets               Budget[]
  clientProjects        ClientProject[]           @relation("ClientProjects")
  managedClientProjects ClientProject[]           @relation("ManagedClientProjects")
  clientUpdates         ClientUpdate[]
  clientRequests        ClientRequest[]
  docsCreated           Document[]                @relation("CreatedDocs")
  clientDocs            Document[]                @relation("DocClient")
  landingEdits          LandingContent[]          @relation("LandingEditor")
  assistantRateLimits   AssistantRateLimit[]
  assistantConfigEdits  AssistantConfiguration[]  @relation("AssistantConfigEditor")
  assistantConversations AssistantConversation[]
  assistantActivities    AssistantActivity[]
}

model AssistantRateLimit {
  id          String   @id @default(cuid())
  userId      String
  windowStart DateTime
  count       Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowStart])
  @@index([windowStart])
}

model AssistantConfiguration {
  id                         String   @id @default("system")
  assistantName              String   @default("NEX")
  iconStyle                  String   @default("BOT")
  accentColor                String   @default("#22C55E")
  greeting                   String   @default("I’m NEX. Ask about your ARKO workspace or create workspace data. I always ask before writing anything.")
  personality                String   @default("Calm, concise, practical, and direct.")
  projectId                  String
  location                   String   @default("global")
  model                      String   @default("gemini-2.5-flash")
  gcpProjectNumber           String   @default("")
  serviceAccountEmail        String   @default("")
  workloadIdentityPoolId     String   @default("vercel")
  workloadIdentityProviderId String   @default("vercel")
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  updatedBy User? @relation("AssistantConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantChatMessage[]

  @@index([userId, updatedAt])
}

model AssistantChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AssistantActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  summary   String
  status    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  ACCOUNTANT
  MEMBER
  USER
  CLIENT
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

// ===== WORKSPACE =====

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ===== FINANCE MODELS =====

model AccountCategory {
  id       String           @id @default(cuid())
  name     String
  type     AccountType
  color    String?          @default("#6b7280")
  icon     String?
  budgetId String?
  userId   String?
  scope    TransactionScope @default(PERSONAL)

  transactions Transaction[]
  budget       Budget?                @relation(fields: [budgetId], references: [id])
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring    RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  RECEIVABLE
  PAYABLE
}

model Transaction {
  id          String           @id @default(cuid())
  amount      Float
  description String?
  type        TransactionType
  scope       TransactionScope @default(PERSONAL)
  isSplit     Boolean          @default(false)
  date        DateTime         @default(now())
  categoryId  String
  userId      String
  workspaceId String?

  category    AccountCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  splitShares SplitShare[]

  @@index([userId, scope, date])
  @@index([scope, date])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionScope {
  PERSONAL
  COMPANY
}

model SplitShare {
  id            String  @id @default(cuid())
  transactionId String
  userId        String
  amount        Float
  settled       Boolean @default(false)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
}

model Budget {
  id          String           @id @default(cuid())
  name        String
  amount      Float
  periodStart DateTime         @default(now())
  periodEnd   DateTime?
  workspaceId String?
  scope       TransactionScope @default(PERSONAL)
  userId      String

  categories AccountCategory[]
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
}

// ===== WORKFLOW MODELS =====

model Workflow {
  id          String           @id @default(cuid())
  name        String
  description String?
  definition  String // JSON/YAML workflow definition
  status      WorkflowStatus   @default(ACTIVE)
  userId      String
  scope       TransactionScope @default(PERSONAL)
  workspaceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user       User                @relation(fields: [userId], references: [id])
  executions WorkflowExecution[]

  @@index([userId, scope])
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model WorkflowExecution {
  id          String          @id @default(cuid())
  workflowId  String
  status      ExecutionStatus @default(PENDING)
  input       String?
  output      String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs     ExecutionLog[]
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  step        String?
  message     String
  level       LogLevel @default(INFO)
  createdAt   DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ===== TASK MODELS =====

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      TaskStatus       @default(TODO)
  priority    Priority         @default(MEDIUM)
  assigneeId  String?
  scope       TransactionScope @default(PERSONAL)
  workspaceId String?
  projectId   String?
  dueDate     DateTime?
  position    Int              @default(0)
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignee User?          @relation(fields: [assigneeId], references: [id])
  project  ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?          @relation("TaskDependencies", fields: [parentId], references: [id])
  subtasks Task[]         @relation("TaskDependencies")

  // Blocking dependencies (distinct from the parent/subtask hierarchy above).
  // `blocking`  = edges where this task blocks another (this task is the blocker).
  // `blockedBy` = edges where this task is blocked by another.
  blocking      TaskDependency[] @relation("BlockingTask")
  blockedBy     TaskDependency[] @relation("BlockedTask")
  clientRequest ClientRequest?

  @@index([assigneeId, position])
  @@index([assigneeId, scope])
  @@index([projectId])
  @@index([parentId])
}

// A directed "A blocks B" edge between two tasks. `blockedId` cannot be marked
// DONE while its blocker is incomplete. Kept separate from the Task self-relation
// so hierarchy (parent/subtasks) and blocking stay independent concepts.
model TaskDependency {
  id         String   @id @default(cuid())
  blockingId String
  blockedId  String
  createdAt  DateTime @default(now())

  blocking Task @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)
  blocked  Task @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockingId, blockedId])
  @@index([blockedId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment {
  id           String   @id @default(cuid())
  content      String
  edited       Boolean  @default(false)
  userId       String
  resourceType String // 'TASK' | 'NOTE' | 'IDEA' ...
  resourceId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}

// ===== MESSAGING MODELS =====

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  // Idempotency key for 1:1 DMs: the two participant ids sorted and joined,
  // e.g. "userA:userB". Unique so the same pair can't create duplicate DMs.
  dmKey     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  conversationId String
  senderId       String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// ===== REMINDER MODELS =====

model Reminder {
  id        String           @id @default(cuid())
  title     String
  note      String?
  dueAt     DateTime
  isDone    Boolean          @default(false)
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  recurrence String          @default("NONE")
  notifyMinutesBefore Int    @default(15)
  lastNotifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, scope])
}

// ===== NOTE MODELS =====

model Note {
  id        String           @id @default(cuid())
  title     String
  content   String
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, scope])
}

// ===== EVENTS / SPRINTS =====

model Event {
  id          String           @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  startTime   String
  endTime     String
  color       String           @default("#2D6A4F")
  userId      String
  scope       TransactionScope @default(PERSONAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, scope, date])
}

model Sprint {
  id        String           @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  color     String           @default("#2D6A4F")
  isActive  Boolean          @default(true)
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([userId, scope, startDate])
}

// ===== IDEAS =====

model Idea {
  id            String           @id @default(cuid())
  title         String
  description   String?
  status        String           @default("IDEA") // IDEA | EXPLORING | VALIDATED | ARCHIVED
  tags          String[]         @default([])
  spawnedTaskId String?
  userId        String
  scope         TransactionScope @default(PERSONAL)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, scope, createdAt])
}

// ===== JOURNAL =====

model JournalEntry {
  id        String           @id @default(cuid())
  title     String
  content   String?
  mood      String?
  date      DateTime         @default(now())
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, scope, date])
}

// ===== NOTIFICATIONS =====

model Notification {
  id        String   @id @default(cuid())
  notifType String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ===== RESOURCES =====

model ResourceCategory {
  id       String  @id @default(cuid())
  name     String
  icon     String  @default("Folder")
  isPublic Boolean @default(true) // public boxes are visible to everyone; private only to the owner
  userId   String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@unique([name, userId])
  @@index([isPublic])
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  url          String?
  resourceType String   @default("LINK") // LINK | FILE | DOC
  description  String?
  tags         String[] @default([])
  fileId       String?
  categoryId   String?
  isPublic     Boolean  @default(true) // public resources are visible/accessible to all users
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([userId])
  @@index([isPublic])
  @@index([updatedAt])
}

// ===== STORAGE (S3) =====

model FileAttachment {
  id           String           @id @default(cuid())
  userId       String
  scope        TransactionScope @default(PERSONAL)
  resourceType String
  resourceId   String?
  fileKey      String
  fileName     String
  fileSize     Int              @default(0)
  mimeType     String           @default("application/octet-stream")
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([userId, scope])
}

// ===== CLIENT PORTAL =====

model ClientProject {
  id        String    @id @default(cuid())
  name      String
  summary   String?
  status    String    @default("PLANNING")
  progress  Int       @default(0)
  startDate DateTime?
  dueDate   DateTime?
  clientId  String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client       User                 @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  owner        User                 @relation("ManagedClientProjects", fields: [ownerId], references: [id], onDelete: Restrict)
  updates      ClientUpdate[]
  requests     ClientRequest[]
  milestones   ProjectMilestone[]
  deliverables ProjectDeliverable[]
  activities   ProjectActivity[]
  tasks        Task[]
  documents    Document[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status])
}

model ClientUpdate {
  id        String   @id @default(cuid())
  content   String
  projectId String
  authorId  String
  createdAt DateTime @default(now())

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model ClientRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("OPEN")
  clientId    String
  projectId   String?
  taskId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([projectId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, completed])
}

model ProjectDeliverable {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?
  status      String   @default("PENDING_REVIEW")
  feedback    String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  action    String
  detail    String
  actorName String?
  projectId String
  createdAt DateTime @default(now())

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ===== FINANCE EXTRAS =====

model BusinessMetric {
  id          String   @id @default(cuid())
  userId      String
  key         String
  name        String
  value       Float    @default(0)
  calculation String   @default("manual")
  suffix      String   @default("")
  upIsGood    Boolean  @default(true)
  decimals    Int      @default(0)
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history MetricHistory[]

  @@unique([userId, key])
}

model MetricHistory {
  id         String   @id @default(cuid())
  metricId   String
  value      Float
  recordedAt DateTime @default(now())

  metric BusinessMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id          String           @id @default(cuid())
  userId      String
  description String
  amount      Float
  type        TransactionType
  scope       TransactionScope @default(PERSONAL)
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  categoryId  String?
  nextDate    DateTime
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ===== DOCUMENTS & INVOICES =====

enum DocumentType {
  INVOICE
  AGREEMENT
  PROPOSAL
  TIMELINE
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  title         String
  status        DocumentStatus @default(DRAFT)
  invoiceNumber String?        @unique
  projectId     String?
  clientId      String?
  content       Json           @default("{}")
  issueDate     DateTime?
  dueDate       DateTime?
  shareToken    String?        @unique
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project   ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    User?              @relation("DocClient", fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User               @relation("CreatedDocs", fields: [createdById], references: [id], onDelete: Restrict)
  lineItems DocumentLineItem[]

  @@index([createdById, status])
  @@index([projectId])
}

model DocumentLineItem {
  id          String   @id @default(cuid())
  documentId  String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  sortOrder   Int      @default(0)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===== LANDING PAGE CMS =====
// Singleton row holding the editable content of the public marketing landing page.
// `singleton` is unique so upserts always target the single row.
model LandingContent {
  id           String    @id @default(cuid())
  singleton    Boolean   @unique @default(true)
  content      Json      @default("{}")
  updatedById  String?
  updatedBy    User?     @relation("LandingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
}

model LandingVisitDaily {
  date      DateTime @id
  viewCount Int      @default(0)
}
