generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== BASE MODELS =====

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  password     String?
  image        String?
  avatar       Json?      @default("{}")
  phone        String?
  title        String?
  role         Role       @default(USER)
  permissions  Json?
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?  @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  authVersion  Int        @default(0)

  accounts                 Account[]
  sessions                 Session[]
  appSessions              AppSession[]
  workspaceMembers         WorkspaceMember[]
  transactions             Transaction[]
  accountCategories        AccountCategory[]
  splitShares              SplitShare[]
  tasks                    Task[]
  reviewRecords            ReviewRecord[]
  comments                 Comment[]
  workflows                Workflow[]
  conversationLinks        ConversationParticipant[]
  sentMessages             Message[]
  reminders                Reminder[]
  notes                    Note[]
  events                   Event[]
  sprints                  Sprint[]
  ideas                    Idea[]
  journalEntries           JournalEntry[]
  notifications            Notification[]
  resources                Resource[]
  resourceCategories       ResourceCategory[]
  fileAttachments          FileAttachment[]
  metrics                  BusinessMetric[]
  recurring                RecurringTransaction[]
  budgets                  Budget[]
  clientProjects           ClientProject[]           @relation("ClientProjects")
  managedClientProjects    ClientProject[]           @relation("ManagedClientProjects")
  clientUpdates            ClientUpdate[]
  clientRequests           ClientRequest[]
  docsCreated              Document[]                @relation("CreatedDocs")
  clientDocs               Document[]                @relation("DocClient")
  landingEdits             LandingContent[]          @relation("LandingEditor")
  assistantRateLimits      AssistantRateLimit[]
  assistantConfigEdits     AssistantConfiguration[]  @relation("AssistantConfigEditor")
  assistantConversations   AssistantConversation[]
  assistantActivities      AssistantActivity[]
  marketingContactsCreated MarketingContact[]        @relation("MarketingContactCreator")
  marketingSegmentsCreated MarketingSegment[]        @relation("MarketingSegmentCreator")
  emailTemplatesCreated    EmailTemplate[]           @relation("EmailTemplateCreator")
  emailCampaignsCreated    EmailCampaign[]           @relation("EmailCampaignCreator")
  emailCampaignsAsClient   EmailCampaign[]           @relation("EmailCampaignClient")
  emailAutomationsCreated  EmailAutomation[]         @relation("EmailAutomationCreator")
  marketingInboxAssigned   MarketingInboundMessage[] @relation("MarketingInboxAssignee")
  marketingInboxNotes      MarketingInboxNote[]
  emailSettingsUpdated     EmailMarketingSettings[]  @relation("EmailSettingsUpdater")
}

model AssistantRateLimit {
  id          String   @id @default(cuid())
  userId      String
  windowStart DateTime
  count       Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowStart])
  @@index([windowStart])
}

model AssistantConfiguration {
  id                         String   @id @default("system")
  assistantName              String   @default("NEX")
  iconStyle                  String   @default("BOT")
  accentColor                String   @default("#22C55E")
  greeting                   String   @default("I’m NEX. Ask about your ARKO workspace or create workspace data. I always ask before writing anything.")
  personality                String   @default("Calm, concise, practical, and direct.")
  projectId                  String
  location                   String   @default("global")
  model                      String   @default("gemini-2.5-flash")
  gcpProjectNumber           String   @default("")
  serviceAccountEmail        String   @default("")
  workloadIdentityPoolId     String   @default("vercel")
  workloadIdentityProviderId String   @default("vercel")
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  updatedBy User? @relation("AssistantConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantChatMessage[]

  @@index([userId, updatedAt])
}

model AssistantChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AssistantActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  summary   String
  status    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSession {
  id               String   @id @default(cuid())
  userId           String
  application      String
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  authVersion      Int
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, application])
  @@index([refreshExpiresAt])
}

enum Role {
  ADMIN
  ACCOUNTANT
  MEMBER
  USER
  CLIENT
  DEMO
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

// ===== WORKSPACE =====

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ===== FINANCE MODELS =====

model AccountCategory {
  id       String           @id @default(cuid())
  name     String
  type     AccountType
  color    String?          @default("#6b7280")
  icon     String?
  budgetId String?
  userId   String?
  scope    TransactionScope @default(PERSONAL)

  transactions Transaction[]
  budget       Budget?                @relation(fields: [budgetId], references: [id])
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring    RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  RECEIVABLE
  PAYABLE
}

model Transaction {
  id          String           @id @default(cuid())
  amount      Float
  description String?
  type        TransactionType
  scope       TransactionScope @default(PERSONAL)
  isSplit     Boolean          @default(false)
  date        DateTime         @default(now())
  categoryId  String
  userId      String
  workspaceId String?

  category    AccountCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  splitShares SplitShare[]

  @@index([userId, scope, date])
  @@index([scope, date])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionScope {
  PERSONAL
  COMPANY
}

model SplitShare {
  id            String  @id @default(cuid())
  transactionId String
  userId        String
  amount        Float
  settled       Boolean @default(false)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
}

model Budget {
  id          String           @id @default(cuid())
  name        String
  amount      Float
  periodStart DateTime         @default(now())
  periodEnd   DateTime?
  workspaceId String?
  scope       TransactionScope @default(PERSONAL)
  userId      String

  categories AccountCategory[]
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
}

// ===== WORKFLOW MODELS =====

model Workflow {
  id          String           @id @default(cuid())
  name        String
  description String?
  definition  String // JSON/YAML workflow definition
  status      WorkflowStatus   @default(ACTIVE)
  userId      String
  scope       TransactionScope @default(PERSONAL)
  workspaceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user       User                @relation(fields: [userId], references: [id])
  executions WorkflowExecution[]

  @@index([userId, scope])
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model WorkflowExecution {
  id          String          @id @default(cuid())
  workflowId  String
  status      ExecutionStatus @default(PENDING)
  input       String?
  output      String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs     ExecutionLog[]
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  step        String?
  message     String
  level       LogLevel @default(INFO)
  createdAt   DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ===== TASK MODELS =====

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      TaskStatus       @default(TODO)
  priority    Priority         @default(MEDIUM)
  assigneeId  String?
  scope       TransactionScope @default(PERSONAL)
  workspaceId String?
  projectId   String?
  dueDate     DateTime
  position    Int              @default(0)
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignee User?          @relation(fields: [assigneeId], references: [id])
  project  ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?          @relation("TaskDependencies", fields: [parentId], references: [id])
  subtasks Task[]         @relation("TaskDependencies")
  reviews  ReviewRecord[]

  // Blocking dependencies (distinct from the parent/subtask hierarchy above).
  // `blocking`  = edges where this task blocks another (this task is the blocker).
  // `blockedBy` = edges where this task is blocked by another.
  blocking      TaskDependency[] @relation("BlockingTask")
  blockedBy     TaskDependency[] @relation("BlockedTask")
  clientRequest ClientRequest?

  @@index([assigneeId, position])
  @@index([assigneeId, scope])
  @@index([projectId])
  @@index([parentId])
}

// A directed "A blocks B" edge between two tasks. `blockedId` cannot be marked
// DONE while its blocker is incomplete. Kept separate from the Task self-relation
// so hierarchy (parent/subtasks) and blocking stay independent concepts.
model TaskDependency {
  id         String   @id @default(cuid())
  blockingId String
  blockedId  String
  createdAt  DateTime @default(now())

  blocking Task @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)
  blocked  Task @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockingId, blockedId])
  @@index([blockedId])
}

// A human review of a task's code, recorded before the task may move to DONE.
// The review gate (apps/pm) refuses status=DONE unless at least one record exists.
// `prLink` is stored raw in the MVP (no GitHub API verification).
model ReviewRecord {
  id         String   @id @default(cuid())
  taskId     String
  reviewerId String
  prLink     String
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([reviewerId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment {
  id           String   @id @default(cuid())
  content      String
  edited       Boolean  @default(false)
  userId       String
  resourceType String // 'TASK' | 'NOTE' | 'IDEA' ...
  resourceId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}

// ===== MESSAGING MODELS =====

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  // Idempotency key for 1:1 DMs: the two participant ids sorted and joined,
  // e.g. "userA:userB". Unique so the same pair can't create duplicate DMs.
  dmKey     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  conversationId String
  senderId       String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// ===== REMINDER MODELS =====

model Reminder {
  id                  String           @id @default(cuid())
  title               String
  note                String?
  dueAt               DateTime
  isDone              Boolean          @default(false)
  userId              String
  scope               TransactionScope @default(PERSONAL)
  createdAt           DateTime         @default(now())
  recurrence          String           @default("NONE")
  notifyMinutesBefore Int              @default(15)
  lastNotifiedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, scope])
}

// ===== NOTE MODELS =====

model Note {
  id        String           @id @default(cuid())
  title     String
  content   String
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, scope])
}

// ===== EVENTS / SPRINTS =====

model Event {
  id          String           @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  startTime   String
  endTime     String
  color       String           @default("#2D6A4F")
  userId      String
  scope       TransactionScope @default(PERSONAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, scope, date])
}

model Sprint {
  id        String           @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  color     String           @default("#2D6A4F")
  isActive  Boolean          @default(true)
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([userId, scope, startDate])
}

// ===== IDEAS =====

model Idea {
  id            String           @id @default(cuid())
  title         String
  description   String?
  status        String           @default("IDEA") // IDEA | EXPLORING | VALIDATED | ARCHIVED
  tags          String[]         @default([])
  spawnedTaskId String?
  userId        String
  scope         TransactionScope @default(PERSONAL)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, scope, createdAt])
}

// ===== JOURNAL =====

model JournalEntry {
  id        String           @id @default(cuid())
  title     String
  content   String?
  mood      String?
  date      DateTime         @default(now())
  userId    String
  scope     TransactionScope @default(PERSONAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, scope, date])
}

// ===== NOTIFICATIONS =====

model Notification {
  id        String   @id @default(cuid())
  notifType String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ===== RESOURCES =====

model ResourceCategory {
  id       String  @id @default(cuid())
  name     String
  icon     String  @default("Folder")
  isPublic Boolean @default(true) // public boxes are visible to everyone; private only to the owner
  userId   String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@unique([name, userId])
  @@index([isPublic])
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  url          String?
  resourceType String   @default("LINK") // LINK | FILE | DOC
  description  String?
  tags         String[] @default([])
  fileId       String?
  categoryId   String?
  isPublic     Boolean  @default(true) // public resources are visible/accessible to all users
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([userId])
  @@index([isPublic])
  @@index([updatedAt])
}

// ===== STORAGE (S3) =====

model FileAttachment {
  id           String           @id @default(cuid())
  userId       String
  scope        TransactionScope @default(PERSONAL)
  resourceType String
  resourceId   String?
  fileKey      String
  fileName     String
  fileSize     Int              @default(0)
  mimeType     String           @default("application/octet-stream")
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([userId, scope])
}

// ===== CLIENT PORTAL =====

model ClientProject {
  id        String    @id @default(cuid())
  name      String
  summary   String?
  status    String    @default("PLANNING")
  progress  Int       @default(0)
  startDate DateTime?
  dueDate   DateTime?
  clientId  String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client         User                 @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  owner          User                 @relation("ManagedClientProjects", fields: [ownerId], references: [id], onDelete: Restrict)
  updates        ClientUpdate[]
  requests       ClientRequest[]
  milestones     ProjectMilestone[]
  deliverables   ProjectDeliverable[]
  activities     ProjectActivity[]
  tasks          Task[]
  documents      Document[]
  emailCampaigns EmailCampaign[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status])
}

model ClientUpdate {
  id        String   @id @default(cuid())
  content   String
  projectId String
  authorId  String
  createdAt DateTime @default(now())

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model ClientRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("OPEN")
  clientId    String
  projectId   String?
  taskId      String?  @unique
  githubOwner String?
  githubRepo String?
  githubBranch String?
  githubLastSha String?
  githubSyncedAt DateTime?
  progressCompleted Int?
  progressTotal Int?
  progressItems Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commitUpdates ClientRequestCommitUpdate[]

  @@index([clientId, status])
  @@index([projectId])
}

model ClientRequestCommitUpdate {
  id String @id @default(cuid())
  requestId String
  sha String
  subject String
  committedAt DateTime
  createdAt DateTime @default(now())

  request ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, sha])
  @@index([requestId, committedAt])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, completed])
}

model ProjectDeliverable {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?
  status      String   @default("PENDING_REVIEW")
  feedback    String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  action    String
  detail    String
  actorName String?
  projectId String
  createdAt DateTime @default(now())

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ===== EMAIL MARKETING =====

enum MarketingContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  INVALID
  ARCHIVED
}

enum MarketingSegmentType {
  STATIC
  DYNAMIC
}

enum EmailTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  CANCELLED
  FAILED
}

enum EmailAudienceRuleType {
  INCLUDE
  EXCLUDE
}

enum EmailRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
  OPENED
  CLICKED
  CANCELLED
}

enum EmailSuppressionReason {
  UNSUBSCRIBED
  BOUNCE
  COMPLAINT
  INVALID
  MANUAL
}

enum EmailAutomationTrigger {
  CONTACT_ADDED
  TAG_ADDED
  BIRTHDAY
  DATE_BASED
  SUBSCRIPTION_CONFIRMED
}

enum EmailAutomationAction {
  SEND_EMAIL
  WAIT
  ADD_TAG
  REMOVE_TAG
  END
}

enum EmailAutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EmailAutomationEnrollmentStatus {
  PENDING
  RUNNING
  COMPLETED
  PAUSED
  FAILED
  CANCELLED
}

enum MarketingInboxStatus {
  UNREAD
  OPEN
  DONE
  TRASHED
}

model MarketingSource {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts MarketingContact[]
}

model MarketingContact {
  id                String                 @id @default(cuid())
  email             String                 @unique
  firstName         String?
  lastName          String?
  company           String?
  phone             String?
  birthday          DateTime?
  street            String?
  address2          String?
  city              String?
  region            String?
  postal            String?
  country           String?
  status            MarketingContactStatus @default(SUBSCRIBED)
  consentSource     String?
  consentAt         DateTime?
  unsubscribeToken  String                 @unique @default(cuid())
  providerContactId String?                @unique
  sourceId          String?
  createdById       String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  source        MarketingSource?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy     User                        @relation("MarketingContactCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tags          MarketingContactTag[]
  segments      MarketingSegmentMember[]
  campaignRules EmailCampaignContact[]
  recipients    EmailCampaignRecipient[]
  enrollments   EmailAutomationEnrollment[]
  inboxMessages MarketingInboundMessage[]

  @@index([status, createdAt])
  @@index([sourceId])
  @@index([company])
}

model MarketingTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      MarketingContactTag[]
  campaignRules EmailCampaignTag[]
}

model MarketingContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     MarketingTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId, createdAt])
}

model MarketingSegment {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  type        MarketingSegmentType @default(STATIC)
  filters     Json                 @default("{}")
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy     User                     @relation("MarketingSegmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       MarketingSegmentMember[]
  campaignRules EmailCampaignSegment[]
}

model MarketingSegmentMember {
  segmentId String
  contactId String
  createdAt DateTime @default(now())

  segment MarketingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
  @@index([contactId])
}

model EmailTemplate {
  id          String              @id @default(cuid())
  name        String
  description String?
  subject     String
  previewText String?
  htmlBody    String
  textBody    String?
  status      EmailTemplateStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  createdBy User            @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  campaigns EmailCampaign[]

  @@index([status, updatedAt])
}

model EmailCampaign {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  status              EmailCampaignStatus @default(DRAFT)
  fromName            String
  fromEmail           String
  replyTo             String?
  subject             String
  previewText         String?
  htmlBody            String
  textBody            String?
  timezone            String              @default("Asia/Manila")
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  providerBroadcastId String?             @unique
  recipientCount      Int                 @default(0)
  sentCount           Int                 @default(0)
  deliveredCount      Int                 @default(0)
  failedCount         Int                 @default(0)
  openedCount         Int                 @default(0)
  clickedCount        Int                 @default(0)
  templateId          String?
  clientId            String?
  projectId           String?
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  template      EmailTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client        User?                     @relation("EmailCampaignClient", fields: [clientId], references: [id], onDelete: SetNull)
  project       ClientProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy     User                      @relation("EmailCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  contactRules  EmailCampaignContact[]
  tagRules      EmailCampaignTag[]
  segmentRules  EmailCampaignSegment[]
  recipients    EmailCampaignRecipient[]
  inboxMessages MarketingInboundMessage[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([clientId])
  @@index([projectId])
}

model EmailCampaignContact {
  campaignId String
  contactId  String
  ruleType   EmailAudienceRuleType @default(INCLUDE)

  campaign EmailCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([campaignId, contactId])
  @@index([contactId])
}

model EmailCampaignTag {
  campaignId String
  tagId      String
  ruleType   EmailAudienceRuleType @default(INCLUDE)

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag      MarketingTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@index([tagId])
}

model EmailCampaignSegment {
  campaignId String
  segmentId  String
  ruleType   EmailAudienceRuleType @default(INCLUDE)

  campaign EmailCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  segment  MarketingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([campaignId, segmentId])
  @@index([segmentId])
}

model EmailCampaignRecipient {
  id              String               @id @default(cuid())
  campaignId      String
  contactId       String?
  email           String
  firstName       String?
  lastName        String?
  status          EmailRecipientStatus @default(QUEUED)
  providerEmailId String?              @unique
  errorMessage    String?
  queuedAt        DateTime             @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failedAt        DateTime?
  updatedAt       DateTime             @updatedAt

  campaign EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  MarketingContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events   EmailDeliveryEvent[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
}

model EmailDeliveryEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  providerEmailId String?
  recipientId     String?
  type            String
  payload         Json     @default("{}")
  eventAt         DateTime
  createdAt       DateTime @default(now())

  recipient EmailCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([providerEmailId])
  @@index([type, eventAt])
}

model EmailSuppression {
  id           String                 @id @default(cuid())
  email        String                 @unique
  reason       EmailSuppressionReason
  source       String
  details      String?
  suppressedAt DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([reason, suppressedAt])
}

model EmailAutomation {
  id            String                 @id @default(cuid())
  name          String
  description   String?
  trigger       EmailAutomationTrigger
  triggerConfig Json                   @default("{}")
  status        EmailAutomationStatus  @default(DRAFT)
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy   User                        @relation("EmailAutomationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  steps       EmailAutomationStep[]
  enrollments EmailAutomationEnrollment[]

  @@index([status, trigger])
}

model EmailAutomationStep {
  id           String                @id @default(cuid())
  automationId String
  position     Int
  action       EmailAutomationAction
  delayMinutes Int                   @default(0)
  config       Json                  @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  automation EmailAutomation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  logs       EmailAutomationExecutionLog[]

  @@unique([automationId, position])
}

model EmailAutomationEnrollment {
  id           String                          @id @default(cuid())
  automationId String
  contactId    String
  runKey       String
  status       EmailAutomationEnrollmentStatus @default(PENDING)
  currentStep  Int                             @default(0)
  nextRunAt    DateTime?
  startedAt    DateTime                        @default(now())
  completedAt  DateTime?
  errorMessage String?
  updatedAt    DateTime                        @updatedAt

  automation EmailAutomation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    MarketingContact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  logs       EmailAutomationExecutionLog[]

  @@unique([automationId, contactId, runKey])
  @@index([status, nextRunAt])
  @@index([contactId])
}

model EmailAutomationExecutionLog {
  id           String   @id @default(cuid())
  enrollmentId String
  stepId       String?
  status       String
  message      String
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  enrollment EmailAutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       EmailAutomationStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
}

model MarketingInboundMessage {
  id                String               @id @default(cuid())
  providerMessageId String               @unique
  senderName        String?
  senderEmail       String
  recipientEmail    String?
  subject           String
  textBody          String?
  htmlBody          String?
  status            MarketingInboxStatus @default(UNREAD)
  contactId         String?
  campaignId        String?
  assignedToId      String?
  receivedAt        DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  contact    MarketingContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign   EmailCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedTo User?                @relation("MarketingInboxAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      MarketingInboxNote[]

  @@index([status, receivedAt])
  @@index([contactId])
  @@index([campaignId])
}

model MarketingInboxNote {
  id        String   @id @default(cuid())
  messageId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  message MarketingInboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
}

model EmailMarketingSettings {
  id             String   @id @default("system")
  provider       String   @default("RESEND")
  fromName       String   @default("ARKO")
  fromEmail      String   @default("onboarding@resend.dev")
  replyTo        String?
  inboundAddress String?
  trackOpens     Boolean  @default(true)
  trackClicks    Boolean  @default(true)
  companyName    String   @default("ARKO")
  companyAddress String   @default("")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updatedBy User? @relation("EmailSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ===== FINANCE EXTRAS =====

model BusinessMetric {
  id          String   @id @default(cuid())
  userId      String
  key         String
  name        String
  value       Float    @default(0)
  calculation String   @default("manual")
  suffix      String   @default("")
  upIsGood    Boolean  @default(true)
  decimals    Int      @default(0)
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history MetricHistory[]

  @@unique([userId, key])
}

model MetricHistory {
  id         String   @id @default(cuid())
  metricId   String
  value      Float
  recordedAt DateTime @default(now())

  metric BusinessMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id          String           @id @default(cuid())
  userId      String
  description String
  amount      Float
  type        TransactionType
  scope       TransactionScope @default(PERSONAL)
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  categoryId  String?
  nextDate    DateTime
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ===== DOCUMENTS & INVOICES =====

enum DocumentType {
  INVOICE
  AGREEMENT
  PROPOSAL
  TIMELINE
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  title         String
  status        DocumentStatus @default(DRAFT)
  invoiceNumber String?        @unique
  projectId     String?
  clientId      String?
  content       Json           @default("{}")
  issueDate     DateTime?
  dueDate       DateTime?
  shareToken    String?        @unique
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project   ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    User?              @relation("DocClient", fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User               @relation("CreatedDocs", fields: [createdById], references: [id], onDelete: Restrict)
  lineItems DocumentLineItem[]

  @@index([createdById, status])
  @@index([projectId])
}

model DocumentLineItem {
  id          String   @id @default(cuid())
  documentId  String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  sortOrder   Int      @default(0)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===== LANDING PAGE CMS =====
// Singleton row holding the editable content of the public marketing landing page.
// `singleton` is unique so upserts always target the single row.
model LandingContent {
  id           String    @id @default(cuid())
  singleton    Boolean   @unique @default(true)
  content      Json      @default("{}")
  updatedById  String?
  updatedBy    User?     @relation("LandingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
}

model LandingVisitDaily {
  date      DateTime @id
  viewCount Int      @default(0)
}
