# Database — reuse the SAME Supabase Postgres that Django uses, but Prisma lives in its own
# dedicated `arko` schema (Django keeps `public`). Use the IPv4 pooler (the direct
# db.<ref>.supabase.co host is IPv6-only). Note the pooler prefix may be aws-0 OR aws-1.
#   DATABASE_URL = transaction pooler :6543 (app runtime)  → needs pgbouncer=true
#   DIRECT_URL   = session pooler :5432 (migrations)
# Both carry schema=arko so Prisma never touches Django's public tables.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=arko"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=arko"

# NextAuth (v5)
# Generate a strong random AUTH_SECRET for production:
#   openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI assistant — replace these values to switch Google Cloud accounts.
# Local development uses your gcloud Application Default Credentials.
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_VERTEX_MODEL="gemini-2.5-flash"

# Vercel OIDC → Google Cloud Workload Identity Federation (production only)
GCP_PROJECT_NUMBER="123456789012"
GCP_SERVICE_ACCOUNT_EMAIL="arko-vertex-runtime@your-project.iam.gserviceaccount.com"
GCP_WORKLOAD_IDENTITY_POOL_ID="vercel"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="vercel"

# File storage — S3-compatible (Django uses Supabase Storage). For AWS S3, omit S3_ENDPOINT.
S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET="arko-attachments"

# Email marketing — Resend API, signed webhooks, and scheduled dispatch
RESEND_API_KEY="re_your_api_key"
# Full-access key used only to retrieve inbound message content.
RESEND_INBOUND_API_KEY="re_your_inbound_api_key"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_secret"
CRON_SECRET="generate-a-random-secret"

# Facebook Page posts shown automatically on the public Blogs page
FACEBOOK_PAGE_ID="your-page-id"
FACEBOOK_PAGE_ACCESS_TOKEN="your-page-access-token"
