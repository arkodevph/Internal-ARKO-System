{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "regions": ["syd1"],
  "env": {
    "ARKO_SURFACE": "site",
    "ARKO_API_URL": "https://app.arkodevph.com"
  },
  "buildCommand": "cd ../.. && ARKO_SURFACE=site ARKO_API_URL=https://app.arkodevph.com pnpm --filter @arko/web build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile"
}
